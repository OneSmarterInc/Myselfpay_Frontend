{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/mailer/unsubscribe",
      "destination": "https://myselfpaybackend.onesmarter.com/api/mailer/unsubscribe"
    },
    {
      "source": "/api/mailer/unsubscribe/:token/",
      "destination": "https://myselfpaybackend.onesmarter.com/api/mailer/unsubscribe/:token"
    },
    {
      "source": "/api/mailer/unsubscribe/:token",
      "destination": "https://myselfpaybackend.onesmarter.com/api/mailer/unsubscribe/:token"
    },
    {
      "source": "/admin/",
      "destination": "https://myselfpaybackend.onesmarter.com/admin/"
    },
    {
      "source": "/admin/:path*/",
      "destination": "https://myselfpaybackend.onesmarter.com/admin/:path*/"
    },
    {
      "source": "/admin",
      "destination": "https://myselfpaybackend.onesmarter.com/admin/"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://myselfpaybackend.onesmarter.com/admin/:path*/"
    },
    {
      "source": "/admin-assets/:path*",
      "destination": "https://myselfpaybackend.onesmarter.com/admin-assets/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://myselfpaybackend.onesmarter.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/admin-assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/admin/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/admin/:path*/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
